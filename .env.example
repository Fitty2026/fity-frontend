# 백엔드 API 서버 주소 (끝 슬래시 없이)
# 개발: https://fitty.gubiko.dev / AWS·데모: https://aws-fitty.gubiko.dev
VITE_API_BASE_URL=

# OpenWeatherMap API 키 (없으면 날씨 조회 결과가 항상 null → weather 없이 코디 생성)
VITE_OPENWEATHER_API_KEY=

# 카카오 REST API 키 (소셜 로그인)
VITE_KAKAO_CLIENT_ID=

# 구글 OAuth 클라이언트 ID (소셜 로그인)
VITE_GOOGLE_CLIENT_ID=
